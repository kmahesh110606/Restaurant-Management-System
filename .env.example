# =============================================================================
# Restaurant Management System — Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# ---- Database (Postgres) ----
DB_NAME=rms_db
DB_USER=rms_user
DB_PASSWORD=rms_password
DB_HOST=db
DB_PORT=5432

# ---- Frontend URL (for QR code generation) ----
FRONTEND_URL=http://localhost:3000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Google OAuth 2.0 (get credentials from Google Cloud Console) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Vite (frontend build) ----
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
